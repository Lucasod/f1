# F04 Stripe CLI dedicated container
# - Installs Stripe CLI v1.55.13 via GitHub release curl download
# - Sets up sandbox profile owned by container user (not a host mount)
# - Auth persistence: STRIPE_API_KEY and STRIPE_WEBHOOK_SECRET are supplied
#   at container start via environment variables; the Stripe CLI config
#   directory (~/.stripe/) persists across container restarts via a named
#   Docker volume (stripe-cli-auth-f04) mounted in docker-compose.yml,
#   but is NEVER mounted from the host filesystem.
# - No baked CLI tokens into image
# - No host profile copies
# - CMD runs stripe listen with the events required for F04 webhook handling

FROM python:3.11-slim

# Environment variables supplied at container start:
#   STRIPE_API_KEY       — the secret key (sk_live_ or sk_test_) for API access
#   STRIPE_WEBHOOK_SECRET — the webhook signing secret (whsec_*)
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

# Install curl for Stripe CLI download (python:3.11-slim does not include it)
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Install Stripe CLI v1.55.13 using GitHub release curl download
# (not an apt repository method — this avoids adding external package repositories)
RUN curl -L -o /tmp/stripe-cli.tar.gz "https://github.com/stripe/stripe-cli/releases/download/v1.55.13/stripe_1.55.13_linux_x86_64.tar.gz" && \
    tar -xzf /tmp/stripe-cli.tar.gz -C /tmp && \
    mv /tmp/stripe /usr/local/bin/stripe && \
    chmod +x /usr/local/bin/stripe && \
    rm /tmp/stripe-cli.tar.gz

# Create a non-root user matching the project convention (uid/gid 1000)
# The ~/.stripe/ directory ownership is managed by the named volume
# stripe-cli-auth-f04 in docker-compose.yml, not by chown in the Dockerfile.
RUN useradd -m -u 1000 -G sudo stripeuser && \
    chown -R stripeuser:stripeuser /home/stripeuser

USER stripeuser

WORKDIR /app

# Run stripe listen with the events required for F04
# --forward-to routes webhooks to the backend Django API
# --events selects the event types the F04 marketplace cares about
# Environment variables STRIPE_API_KEY and STRIPE_WEBHOOK_SECRET
# must be set when starting the container; they are NOT baked into this image.
# CMD validates STRIPE_WEBHOOK_SECRET is set (no network access required)
# and then executes stripe listen with all required events.
CMD ["bash", "-c", "if [ -z \"$STRIPE_WEBHOOK_SECRET\" ]; then echo \"MISSING\" >&2; exit 1; fi; echo \"CONFIGURED\"; exec stripe listen --forward-to \"http://backend:8000/api/v1/integrations/stripe/webhook/\" --events \"checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.async_payment_failed,checkout.session.expired,customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,invoice.paid,invoice.payment_failed\""]