# F04 Backend Environment Variables
# SQLite eliminated; PostgreSQL + Redis required

SECRET_KEY=django-insecure-f04-development-key-do-not-use-in-production
DEBUG=False

# PostgreSQL configuration
POSTGRES_DB=f04
POSTGRES_USER=f04
POSTGRES_PASSWORD=MISSING
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
