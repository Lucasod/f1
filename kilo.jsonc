{
  "$schema": "https://app.kilo.ai/config.json",
  "instructions": [
    ".kilo/rules/universal-rules.md",
    ".kilo/rules/project-rules.md",
    ".kilo/rules/autonomous-execution.md"
  ],
  "agent": {
    "agent": {
    "code-orchestrator": {
      "model": "kilo/reflection/beam-free"
      }
    }
  },
  "indexing": {
    "fileExtensions": [
      ".cjs",
      ".conf",
      ".css",
      ".html",
      ".js",
      ".json",
      ".jsx",
      ".lua",
      ".md",
      ".mdx",
      ".mjs",
      ".scss",
      ".sh",
      ".sql",
      ".tf",
      ".ts",
      ".tsx",
      ".yaml",
      ".yml"
    ],
    "enabled": true,
    "model": "nomic-embed-text"
  },
  "mcp": {
  }
}